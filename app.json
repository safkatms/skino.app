{
  "expo": {
    "name": "Skino",
    "slug": "skino-expo",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "skino",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.skino.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "icon": "./assets/skinO.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/skinO-foreground.png",
        "backgroundColor": "#4F46E5"
      },
      "package": "com.skino.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "05f2f240-9065-425e-a50c-04a7015c7624"
      }
    }
  }
}
